# PostgreSQL connection string (e.g., Neon, Supabase, or local PostgreSQL)
# Never commit .env.local or real credentials.
DATABASE_URL=postgresql://user:password@host:5432/wow_forever_farm?sslmode=require

# Optional: Free EverlookDB API key (raises rate limit from ~5 req/s to 50 req/s)
# Obtain free key at https://everlookdb.com/api.html
EVERLOOKDB_API_KEY=

# Optional: Official Blizzard Battle.net Game Data API (canonical WoW Forever ruleset AH adapter)
# Obtain free client credentials at https://develop.battle.net/
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Optional: Ingestion tuning
SYNC_REGIONS=us,eu
FOREVER_AH_MAX_RPS=1
EVERLOOKDB_MAX_RPS=5

# Optional: Local in-game addon SavedVariables auto-watcher (npm run watch:addon)
WOW_SAVEDVARS_PATH=
WATCH_ADDON_MARKET_ID=us:0
